# =============================================================================
# 器材装备出入库记录小程序 - 部署环境变量模板
# 用法：复制为 .env 并填入真实值，docker-compose 会自动读取同目录 .env
# 注意：切勿将真实 .env 提交到代码仓库
# =============================================================================

# ---------- 后端服务 ----------
PORT=3000
NODE_ENV=production
# SQLite 数据库文件路径（容器内建议 /app/data/equipment.db 以挂载持久卷）
DB_PATH=/app/data/equipment.db

# ---------- JWT ----------
# 生产环境务必改为强随机串（≥32 字符），否则 token 可被伪造
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---------- 微信小程序 ----------
# 在微信公众平台 -> 开发 -> 开发管理 -> 开发设置 获取
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret
# 微信订阅消息模板 ID（在订阅消息 -> 我的模板 申请出入库通知模板后填写）
WX_SUBSCRIBE_TEMPLATE_ID=your-template-id

# ---------- 多模态 AI（OpenAI 兼容接口） ----------
# provider: qwen | openai
AI_PROVIDER=qwen
# Qwen 示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI 示例：https://api.openai.com/v1
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=your-ai-api-key
# Qwen: qwen-vl-max | OpenAI: gpt-4o
AI_MODEL=qwen-vl-max

# ---------- 上传与业务阈值 ----------
# 上传文件存储目录（容器内建议挂载到持久卷）
UPLOAD_DIR=/app/data/uploads
# 低库存预警阈值（库存低于此值在仪表盘红色高亮）
LOW_STOCK_THRESHOLD=5

# ---------- 前端构建期变量（编译小程序/H5 时注入） ----------
# 后端 API 基址（注意：实际读取的变量名为 TARO_APP_API_BASE_URL）
TARO_APP_API_BASE_URL=http://localhost:3000/api
