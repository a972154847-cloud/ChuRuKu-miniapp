# 服务端口
PORT=3000
NODE_ENV=development
DB_PATH=./dev.db

# JWT
JWT_SECRET=please-generate-a-64-char-random-string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://192.168.101.65:3000

# 微信小程序
WX_APP_ID=
WX_APP_SECRET=

# 多模态 AI（Qwen3-VL 或 OpenAI 兼容接口）
AI_PROVIDER=qwen
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-vl-max

# 上传
UPLOAD_DIR=./uploads
LOW_STOCK_THRESHOLD=5
